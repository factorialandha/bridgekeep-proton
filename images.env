# Published images: private on GitHub's container registry for now.
# CI (scripts/publish-images.sh) pushes and signs them; hosts pull and verify
# them with scripts/pull-image.sh, and fall back to building locally.
# See docs/images.md.
#
# Going public later is a visibility switch on the two packages in GitHub,
# plus COSIGN_TLOG=true below. Nothing else changes.

IMAGE_REGISTRY=ghcr.io/factorialandha
BRIDGE_IMAGE_NAME=bridgekeep-bridge
ANALYZER_IMAGE_NAME=bridgekeep-analyzer

# Main has its own signing key (owner decision, 2026-11-25): main images are signed
# with keys/cosign-main.pub's key, preview images with keys/cosign.pub's.
# Every signature must also name this repository and the branch (and, for a
# commit tag, the commit). See docs/images.md.
IMAGE_SOURCE_REPO=factorialandha/bridgekeep-proton
#
# false while private: a public transparency-log (Rekor) entry would publish
# the image names and digests. Set true once the images are public.
COSIGN_TLOG=false

COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v2.6.1@sha256:68839b7f13dac5a6744a5d8818e984dd39183374e37855c19e14d623d9bc9037
