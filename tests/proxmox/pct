#!/usr/bin/env bash
# Stand-in for Proxmox's pct, for tests/proxmox.sh. Containers are folders in
# $PX/ct/ID (config, state); a container's / is $PX/root/ID. Every call is
# logged to $PX/log. exec runs only what proxmox.sh is known to run.
set -euo pipefail
echo "pct $*" >>"$PX/log"
cmd=$1; shift
ctdir() { echo "$PX/ct/$1"; }
case $cmd in
  list)
    env >"$PX/env-host"   # what proxmox.sh itself runs with
    echo "VMID       Status     Lock         Name"
    for d in "$PX"/ct/*/; do [[ -d $d ]] && echo "$(basename "$d") running bridgekeep"; done; true ;;
  config) [[ -f $(ctdir "$1")/config ]] || { echo "Configuration file does not exist" >&2; exit 2; }; cat "$(ctdir "$1")/config" ;;
  status) [[ -d $(ctdir "$1") ]] || exit 2; echo "status: $(cat "$(ctdir "$1")/state")" ;;
  create)
    id=$1; shift; mkdir -p "$(ctdir "$id")" "$PX/root/$id/root"
    printf '%s\n' "$@" >"$(ctdir "$id")/create-args"
    host=bridgekeep tags=''
    while (($#)); do case $1 in --hostname) host=$2 ;; --tags) tags=$2 ;; esac; shift; done
    printf 'hostname: %s\ntags: %s\n' "$host" "$tags" >"$(ctdir "$id")/config"
    echo stopped >"$(ctdir "$id")/state" ;;
  start) echo running >"$(ctdir "$1")/state" ;;
  push) mkdir -p "$(dirname "$PX/root/$1$3")"; cp "$2" "$PX/root/$1$3" ;;
  enter) echo "entered $1" ;;
  exec)
    id=$1; shift; [[ $1 == -- ]] && shift
    [[ $1 == /usr/bin/env && $2 == -i ]] || { echo "exec without a clean environment: $*" >&2; exit 9; }
    shift 2; while [[ $1 == *=* ]]; do shift; done
    all="$*"
    case $all in
      *"hostname -I"*) echo 10.0.0.5 ;;
      getent*) ;;
      *download.docker.com*)
        echo docker-install >>"$PX/log"
        [[ -n ${MOCK_BAD_KEY:-} ]] && { echo "Docker key fingerprint is 0000, expected $5"; exit 3; }
        touch "$PX/ct/$id/docker" ;;
      *"docker compose version"*) [[ -f $PX/ct/$id/docker ]] ;;
      "docker version"*) echo 29.0.0 ;;
      "docker run"*) [[ -z ${MOCK_RUN_FAIL:-} ]] || { echo "runc: permission denied"; exit 1; } ;;
      *bridgekeep-sync*)
        # The sync script, with the container's / under $PX/root/ID.
        r=$PX/root/$id; script=${3//\/root\/bridgekeep-sync/$r\/root\/bridgekeep-sync}
        # The container runs it as root; this test may not be root, so its chown is a no-op here.
        [[ $(/usr/bin/id -u) == 0 ]] || script=${script//chown root:root/: chown}
        sh -c "$script" _ "$r$5" ;;
      *"./bridgekeep"*) echo "bridgekeep in $id: ${*:6}" >>"$PX/log"; [[ -x $PX/root/$id$5/bridgekeep ]] || exit 1 ;;
      *) echo "unexpected exec: $all" >&2; exit 9 ;;
    esac ;;
  *) echo "pct stub: no $cmd" >&2; exit 9 ;;
esac
